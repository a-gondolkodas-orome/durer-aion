{
  "name": "React Dev Container",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    // Keep in sync with the repository root's .nvmrc — the root `npm test` fails on a
    // mismatch. Listed first so the features that
    // install global npm packages run against this Node.
    "ghcr.io/devcontainers/features/node:1": { "version": "24.20.0" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "mounts": [
    "source=durer-gh-config,target=/home/node/.config/gh,type=volume",
    "source=durer-claude-home,target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
        , "bradlc.vscode-tailwindcss"
        , "anthropic.claude-code"
        , "streetsidesoftware.code-spell-checker"
        , "vitest.explorer"
      ],
      // Inlined rather than committed as a .vscode/settings.json, as the repository root
      // does — README.md § IDE setup says why. Keep in step with the root
      // .vscode/settings.json; paths differ because the workspace folder here is this app.
      "settings": {
        // detectIndentation guesses from the file being edited and overrides tabSize
        // wherever it guesses differently, so the two below only hold with it off.
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        // Formatting is eslint's here too (apps/strategy-practice/eslint.config.js), so
        // saving runs its fixes rather than a formatter: leaving formatOnSave to whatever
        // the user has globally lets VS Code's built-in TypeScript formatter undo them.
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
        "tailwindCSS.experimental.configFile": "src/styles.css",
        "javascript.updateImportsOnFileMove.enabled": "always",
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true
      }
    }
  },
  // At the repository root, not here: this app is a workspace of the monorepo, there is
  // one lockfile at the root, and `npm ci` from a workspace directory leaves the root's own
  // dependencies unmet while still exiting 0.
  "postCreateCommand": "npm ci --prefix ../..",
  "forwardPorts": [8012],
  "portsAttributes": {
    "8012": {
      "label": "Dev Server"
    }
  }
}
