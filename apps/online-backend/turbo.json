{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The bundle reads the workspace packages' source (tsdown.config.mts), so
    // neither the build nor the watching dev server waits for their builds.
    // `typecheck` still does: tsc resolves the packages through their exports
    // maps, to the declarations in `dist`.
    "build": { "dependsOn": [] },
    "dev": { "dependsOn": [] }
  }
}
