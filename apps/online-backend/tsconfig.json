{
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    // Typecheck only: tsdown emits the bundle (tsdown.config.mts). nodenext,
    // not commonjs/node10, because Node runs that bundle as CommonJS and tsc
    // should model Node's real resolution — the `exports` field, require() of
    // ESM on Node ≥ 22, which the runtime already relies on for nanoid 6. With
    // no `type: module` in package.json the sources are CommonJS to tsc.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "moduleDetection": "force",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    // No `paths` for the workspace packages: the bundle reads their source
    // through tsdown's aliases, but this typecheck must not — the games' JSX
    // boards would fail it with `--jsx is not set` errors that name the game
    // package rather than the cause. npm links every workspace into
    // node_modules, so a bare `game` resolves on its own, through the `exports`
    // map each package carries, to the declarations in its `dist`; when that
    // is missing the error is one "Cannot find module 'game'" line, pointing
    // at the build that never ran.
    "skipLibCheck": true
  }
}
