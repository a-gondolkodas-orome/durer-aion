{
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    // nodenext, not commonjs/node10: Node runs this output, so tsc should model
    // Node's real resolution (the `exports` field, require() of ESM on Node ≥ 22 —
    // which the runtime already relies on for nanoid 6). With no `type: module` in
    // package.json the emit is still CommonJS, same as before.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "moduleDetection": "force",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": false,
    // No baseUrl (deprecated in TS 6): paths entries resolve relative to this file.
    "paths": {
      "game": ["../../packages/game"],
      "strategy": ["../../packages/strategy"],
      "schemas": ["../../packages/schemas"],
      "common-frontend": ["../../packages/common-frontend"]
    },
    // Pinned, not inferred. tsc otherwise derives the root from the common
    // parent of its inputs, which was the app directory only because a stray
    // config file sat there — deleting it moved the build to dist/server.js and
    // broke `npm start`, which the Dockerfile's CMD runs.
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
  }
}
