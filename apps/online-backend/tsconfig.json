{
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    // Typecheck only: tsdown emits the bundle (tsdown.config.mts). nodenext,
    // not commonjs/node10, because Node runs that bundle as CommonJS and tsc
    // should model Node's real resolution — the `exports` field, require() of
    // ESM on Node ≥ 22, which the runtime already relies on for nanoid 6. With
    // no `type: module` in package.json the sources are CommonJS to tsc.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "moduleDetection": "force",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmit": true,
    // The same sources the bundle reads (tsdown.config.mts), so this typecheck
    // needs no package build either. Only the entries the server imports are
    // mapped: `game/client` is where the games' JSX boards live, and this
    // compile has no `jsx` — a board reached from here fails with `--jsx is
    // not set` errors naming the game package, which is the right outcome.
    // The flip side: those packages' source is compiled under this file's
    // `lib` and `target` as well as their own, so an error in it shows up in
    // both typechecks, and the game package must stay DOM-free.
    "paths": {
      "game": ["../../packages/game/index.ts"],
      "game/bot": ["../../packages/game/bot.ts"],
      "schemas": ["../../packages/schemas/index.ts"],
      "strategy": ["../../packages/strategy/index.ts"]
    },
    "skipLibCheck": true
  }
}
