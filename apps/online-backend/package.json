{
  "name": "online-backend",
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "npx tsdown",
    "start": "node --enable-source-maps dist/server.js",
    "import-teams": "node --enable-source-maps dist/import_teams.js",
    "dev": "tsdown --watch --onSuccess \"node --inspect --enable-source-maps dist/server.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@koa/router": "10.1.1",
    "bgio-postgres": "1.0.16",
    "boardgame.io": "0.50.2",
    "dotenv": "17.4.2",
    "game": "*",
    "ip-address": "10.7.5",
    "koa": "2.16.4",
    "koa-basic-auth": "4.0.0",
    "koa-body": "8.0.1",
    "nanoid": "6.0.2",
    "rate-limiter-flexible": "11.2.3",
    "relay-bot": "*",
    "schemas": "*",
    "sequelize": "6.37.8",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@electric-sql/pglite-socket": "0.2.14",
    "@types/cors": "2.8.19",
    "@types/koa-basic-auth": "2.0.7",
    "@types/node": "26.6.6",
    "socket.io-client": "4.8.4",
    "yaml": "2.9.1"
  }
}
