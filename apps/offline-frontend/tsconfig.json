{
  "ts-node": {
    "compilerOptions": {
        "module": "CommonJS"
    }
  },
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["vite/client"],
    "paths": {
      "game": ["../../packages/game"],
      "game/bot": ["../../packages/game/dist/bot.d.mts"],
      "game/client": ["../../packages/game/dist/client.d.mts"],
      "relay-bot": ["../../packages/relay-bot"],
      "schemas": ["../../packages/schemas"],
      "common-frontend": ["../../packages/common-frontend"]
    }
  },
  "include": [
    "src",
    "../../packages/*/src",
    "../../packages/*/index.d.ts", 
    "../../packages/*/index.ts"
  ],
  // This app typechecks every package's src, not only its own, so it also has to
  // skip every package's suites — those belong to their own workspace's typecheck,
  // and packages/strategy-engine came from apps/strategy-practice, where suites are
  // named .spec rather than .test (root CLAUDE.md § Tech Stack).
  // A `**/` pattern is anchored at this directory and so never reaches up into
  // packages/; the paths below have to walk the same way `include` does. This
  // app's own suites under src/ are not excluded: nothing else typechecks them,
  // and ESLint's project service parses only files a project claims.
  "exclude": [
    "**/__tests__/**",
    "../../packages/*/src/**/*.test.ts",
    "../../packages/*/src/**/*.test.tsx"
  ]
}