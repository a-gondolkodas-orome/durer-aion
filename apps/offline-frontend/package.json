{
  "name": "offline-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "cross-env PUBLIC_URL=/repository-name npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "spell-check": "cspell \"**/*.{ts,tsx}\" --no-progress"
  },
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "@sentry/react": "^10.72.0",
    "boardgame.io": "0.50.*",
    "buffer": "^6.0.3",
    "common-frontend": "*",
    "game": "*",
    "i18next": "^26.4.0",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "strategy": "*"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "boardgame.io": "0.50.*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
