{
  "name": "online-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "dev": "cross-env VITE_SERVER_URL=http://localhost:8000 vite",
    "start": "vite",
    "build": "tsc && vite build",
    "spell-check": "cspell \"**/*.{ts,tsx}\" --no-progress"
  },
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "@sentry/react": "^7.16.0",
    "@sentry/tracing": "^7.16.0",
    "axios": "^1.4.0",
    "buffer": "^6.0.3",
    "common-frontend": "*",
    "game": "*",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^6.3.0",
    "urlcat": "^2.0.4"
  },
  "devDependencies": {
    "@sentry/types": "^7.57.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.3"
  }
}
