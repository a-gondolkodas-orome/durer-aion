{
  "name": "online-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "cross-env PUBLIC_URL=/durer-aion npm run build",
    "deploy": "gh-pages -d build",
    "lint": "cross-env TIMING=1 eslint \"**/*.ts*\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "dev": "cross-env VITE_SERVER_URL=http://localhost:8000 vite",
    "start": "vite",
    "build": "tsc && vite build",
    "spell-check": "cspell \"**/*.{ts,tsx}\" --no-progress"
  },
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.7",
    "@sentry/react": "^10.72.0",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "common-frontend": "*",
    "game": "*",
    "process": "^0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.12",
    "urlcat": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.2"
  }
}
