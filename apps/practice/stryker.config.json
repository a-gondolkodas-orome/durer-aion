{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/components/strategy-game-factory/**/*.ts",
    "src/components/strategy-game-factory/**/*.tsx",
    "!src/components/strategy-game-factory/**/*.spec.ts",
    "!src/components/strategy-game-factory/**/*.spec.tsx"
  ],
  "clearTextReporter": { "maxTestsToLog": 0 },
  "thresholds": { "high": 80, "low": 60, "break": null }
}
