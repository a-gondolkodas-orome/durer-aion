{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test:unit)",
      "Bash(npm run dev)",
      "Bash(npm test)",
      "Bash(npm run coverage)",
      "Bash(npm run coverage:unswept)",
      "Bash(npm run coverage:patch)",
      "Bash(npm run check:versions)",
      "Bash(npm run report:outdated)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm view *)"
    ]
  }
}
