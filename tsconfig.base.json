{
  // What the four packages and the three boardgame.io frontends compile under
  // alike. A package extends this and adds a target where it needs one; a
  // frontend extends it through tsconfig.frontend.json. Options
  // that are relative paths (`include`, `outDir`, `paths`) stay in each
  // workspace, since they resolve against the file that names them. The backend
  // (nodenext, no DOM), apps/strategy-practice and packages/strategy-engine
  // keep configs of their own.
  //
  // Only what differs from TypeScript 6's defaults, which already give
  // `strict`, `esModuleInterop`, consistent casing and `bundler` resolution.
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    // Named because the default follows `target`: under game's and
    // common-frontend's ES6 it is ES2015, which rejects `import.meta`. tsdown
    // and vite do the real emit, so this only tells tsc how to read the sources.
    "module": "ESNext",
    "skipLibCheck": true
  }
}
