{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-review-requests.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue status*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr status*)",
      "Bash(gh search *)",
      "Bash(gh repo view*)",
      "WebSearch",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npx eslint .)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test --workspace=strategy-practice)",
      "Bash(npm run test)",
      "Bash(npm run dev)",
      "Bash(npm run i18n:check)",
      "Bash(npm run spell-check)",
      "Bash(npm run coverage)",
      "Bash(npm run report:outdated)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx turbo run *)",
      "Bash(npm view *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh auth *)",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread",
      "mcp__github__unresolve_review_thread",
      "mcp__github__pull_request_review_write",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__request_copilot_review",
      "Bash(gh pr comment*)",
      "Bash(gh pr review*)",
      "Bash(gh issue comment*)",
      "Bash(gh pr edit*--add-reviewer*)"
    ]
  }
}
