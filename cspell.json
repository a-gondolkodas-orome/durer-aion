    "@cspell/dict-hu-hu/cspell-ext.json"
  ],
  "dictionaries": [
    "hu-hu",
    "en-gb",
    "hu-extra"
  ],
  "words": [
    "addminutes",
    "bgio",
    "BGIO",
    "bivariance",
    "Bivariant",
    "boardgame",
    "boardwrapper",
    "botmoves",
    "botstrategy",
    "botwrapper",
    "completestring",
    "creds",
    "deltalog",
    "dropdownid",
    "durerbackground",
    "formik",
    "gamename",
    "gameobject",
    "gameover",
    "gamestate",
    "gamewrapper",
    "guessnum",
    "joincode",
    "langcode",
    "Langswitcher",
    "Lngs",
    "logoutofthiswholething",
    "matchid",
    "maxpoints",
    "minpoints",
    "nameid",
    "notistack",
    "onwarn",
    "prebundle",
    "prevrelayid",
    "prevstratid",
    "socketio",
    "strat",
    "strategydict",
    "stratstep",
    "teamname",
    "teamstate",
    "teamstates",
    "timeto",
    "tname",
    "TYPELESS",
    "unconfigured",
    "unstarted",
    "unstub",
    "urlcat",
    "wrongid",
    "yearidx"
  ],
  "flagWords": [],
  "ignorePaths": [
    "node_modules",
    "dist",
    "build",
    "*.log",
    "package.json",
    "coverage/**/*",
    "apps/strategy-practice/**",
    "docker-compose*",
    "readme.md",
    "scripts/test.tsv*",
    "**/src/teamData.ts"
  ],
  "languageSettings": [
    {
      "languageId": "typescript"
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "hu-extra",
      "path": "./hungarian-words.txt",
      "addWords": true
    }
  ],
  "overrides": [
    {
      "filename": [
        "apps/relay-practise-frontend/src/problems.ts",
        "packages/strategy/src/games/relay/strategy.ts"
      ],
      "ignoreRegExpList": [
        "/\\\\+[a-zA-Z]+/g",
        "/&[a-z]+;/g",
        "/\\b[A-Z]{2,}\\b/g"
      ]
    }
  ]
}
