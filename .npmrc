# react-text-mask, the login field's mask, declares React up to 18 as its peer;
# without this a fresh resolve fails with ERESOLVE. It also silences every other
# peer conflict, so drop it with the mask.
legacy-peer-deps=true
# Versions are pinned exactly, in every workspace — docs/DEPENDENCIES.md
save-exact=true
# Supply-chain cooldown: resolve nothing published less than 7 days ago, and no
# dependency from a git URL — docs/DEPENDENCIES.md § Release-age cooldown.
# release-age.mjs reads the number from here, so it is written down once.
min-release-age=7
allow-git=none
