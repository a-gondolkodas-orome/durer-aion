{
  "name": "engine",
  "version": "0.0.0",
  "private": true,
  "description": "The strategy-game engine: rules, moves, bots and match state, with no framework attached.",
  "files": [
    "dist/**"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npx tsup",
    "dev": "npx tsup --watch --onSuccess \"echo rebuilt engine\""
  },
  "dependencies": {
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/lodash": "^4.14.182",
    "@types/react": "^19.2.0",
    "vite": "^7.0.3"
  }
}
