{
  "name": "strategy",
  "version": "0.0.0",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npx tsdown",
    "dev": "npx tsdown --watch --no-clean --onSuccess \"echo rebuilt strategy\""
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "game": "*"
  }
}
