{
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here only because the golden spec's oracle (the old gamewrapper)
    // touches localStorage; this package's own code runs in plain Node.
    "lib": ["ES2022", "DOM"],
    "composite": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      // The engine resolves to source, as it does everywhere its specs run —
      // the root vitest suite reads it the same way, so `tsc` here must see
      // the same modules a test executes.
      "engine": ["../engine/index.ts"]
    },
    // vite/client is here for the same one type engine's tsconfig names it
    // for: `import.meta.env` in the engine source the path above resolves into.
    "types": ["vite/client"]
  }
}
