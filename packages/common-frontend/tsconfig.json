{
  "extends": "../../tsconfig.base.json",
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "target": "ES6",
    // Named, not inherited: Main.tsx uses Array.prototype.at, which is ES2022. It
    // typechecked only because @types/node was in this package's dependency block and
    // its compatibility/indexable.d.ts declares .at() — a Node types polyfill standing
    // in for a lib this config never asked for, in a package that does not run in Node.
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    // The paths entry below pulls schemas' source into the program.
    "rootDir": "..",
    // Source, not dist: lint runs before any package is built, and a type that
    // resolves to nothing makes a cast to it look unnecessary.
    "paths": {
      "schemas": ["../schemas/index.ts"]
    }
  }
}
