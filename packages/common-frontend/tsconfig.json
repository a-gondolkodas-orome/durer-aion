{
  "include": ["."],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "module": "ESNext",
    "target": "ES6",
    // Named, not inherited: Main.tsx uses Array.prototype.at, which is ES2022. It
    // typechecked only because @types/node was in this package's dependency block and
    // its compatibility/indexable.d.ts declares .at() — a Node types polyfill standing
    // in for a lib this config never asked for, in a package that does not run in Node.
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    // node10 resolution is deprecated and stops working in TS 7; migrating these
    // configs off it (bundler for the Vite-built code, nodenext for the backend) is
    // its own change. This is TS 6\'s sanctioned bridge until then.
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "outDir": "./dist"
  }
}
