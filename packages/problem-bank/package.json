{
  "name": "problem-bank",
  "version": "0.0.0",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./all": {
      "types": "./dist/all.d.mts",
      "default": "./dist/all.mjs"
    },
    "./banks/*": {
      "types": "./dist/banks/*.d.mts",
      "default": "./dist/banks/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "build": "npx tsdown",
    "dev": "npx tsdown --watch --no-clean --onSuccess \"echo rebuilt problem-bank\""
  },
  "dependencies": {
    "schemas": "*"
  },
  "devDependencies": {
    "game": "*"
  }
}
