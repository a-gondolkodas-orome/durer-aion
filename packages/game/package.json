{
  "name": "game",
  "version": "0.0.0",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bot": {
      "types": "./dist/bot.d.mts",
      "default": "./dist/bot.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "default": "./dist/client.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npx tsdown",
    "dev": "npx tsdown --watch --no-clean --onSuccess \"echo rebuilt game\""
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@types/lodash": "4.17.25",
    "@types/react": "19.2.18"
  },
  "peerDependencies": {
    "boardgame.io": "0.50.*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
