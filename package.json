{
  "name": "durer-aion",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/node": "^7.18.6",
    "@babel/plugin-transform-modules-commonjs": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@koa/cors": "^5.0.0",
    "@mui/icons-material": "^5.11.16",
    "@mui/material": "^5.16.7",
    "@mui/x-data-grid": "^7.16.0",
    "@sentry/node": "^7.58.1",
    "@sentry/react": "^7.16.0",
    "@sentry/tracing": "^7.16.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/koa-basic-auth": "^2.0.4",
    "@types/koa-mount": "^4.0.1",
    "@types/node": "^16.11.41",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.4.0",
    "bgio-postgres": "^1.0.13",
    "boardgame.io": "^0.50.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "formik": "^2.4.2",
    "koa-basic-auth": "^4.0.0",
    "koa-mount": "^4.0.0",
    "nanoid": "^3.0.0",
    "notistack": "^2.0.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.3.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-text-mask": "^5.5.0",
    "swr": "^2.2.5",
    "urlcat": "^2.0.4",
    "vite": "^7.0.3",
    "web-vitals": "^2.1.4",
    "yup": "^0.32.11"
  },
  "scripts": {
    "predeploy": "npx turbo run build --filter=offline-frontend && npm run predeploy --workspace=offline-frontend",
    "deploy": "gh-pages -d apps/offline-frontend/dist",
    "lint": "eslint . --max-warnings=0",
    "lint:turbo": "turbo lint",
    "start": "turbo start",
    "build": "turbo build",
    "spell-check": "cspell \"**/*.{ts,tsx}\" --no-progress",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:server": "turbo dev --filter=online-backend --filter=game --filter=schemas --filter=strategy",
    "dev:online": "turbo dev --filter=online-frontend --filter=game --filter=common-frontend",
    "dev:offline": "turbo dev --filter=offline-frontend --filter=game --filter=strategy --filter=common-frontend",
    "dev:practise": "turbo dev --filter=relay-practise-frontend --filter=game --filter=strategy --filter=common-frontend",
    "dev:strategy-practice": "npm run dev --workspace=strategy-practice",
    "setup": "node scripts/seed-env-files.mjs",
    "stack:up": "npm run build && docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file=.env.docker up --build --wait",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml --env-file=.env.docker down",
    "stack:logs": "docker compose --env-file=.env.docker logs -f",
    "stack:ps": "docker compose --env-file=.env.docker ps",
    "stack:prod": "npm run build && docker compose --env-file=.env.docker up --build --wait",
    "teams:import": "docker compose --env-file=.env.docker exec backend ./scripts/import_teams.sh scripts/test.tsv",
    "teams:import:local": "npx turbo build --filter=online-backend && cd apps/online-backend && node dist/src/server.js import ../../scripts/test.tsv",
    "site:build": "node scripts/assemble-site.mjs",
    "site:serve": "node scripts/serve-site.mjs",
    "db:up": "docker run -it --rm -e POSTGRESQL_PASSWORD=postgres -p 127.0.0.1:5432:5432 bitnami/postgresql",
    "i18n:check": "i18n-check --format i18next --source hu --locales packages/common-frontend/public --unused ./**/src"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "import/no-anonymous-default-export": 0
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "packageManager": "npm@8.5.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "workspaces": [
    "apps/offline-frontend",
    "apps/online-backend",
    "apps/online-frontend",
    "apps/relay-practise-frontend",
    "apps/strategy-practice",
    "packages/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@lingual/i18n-check": "^0.9.5",
    "@sentry/types": "^7.57.0",
    "@testing-library/dom": "^10.4.1",
    "@types/koa__cors": "^5.0.1",
    "@types/pg": "^8.6.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/react-text-mask": "^5.4.14",
    "concurrently": "^9.2.0",
    "cspell": "^6.31.1",
    "eslint": "^9.37.0",
    "gh-pages": "^4.0.0",
    "jsdom": "^30.0.1",
    "nodemon": "^2.0.18",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "turbo": "^2.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.10"
  }
}
