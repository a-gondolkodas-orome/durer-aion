{
  "name": "durer-aion",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:24",
  "features": {
    // The image tag only fixes the Node major (MCR publishes no patch tags), and the
    // patch it happens to bake is older than `engines.node` — hence npm's EBADENGINE
    // warnings on install. Pin it here instead, to the version in .nvmrc —
    // `npm test` fails on a mismatch (scripts/check-versions.test.mjs).
    "ghcr.io/devcontainers/features/node:1": { "version": "24.20.0" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "containerEnv": {
    "DEV_SERVER_HOST": "true"
  },
  "portsAttributes": {
    "5173": { "label": "online / offline / relay practice (vite)" },
    "8012": { "label": "strategy-practice (vite)" },
    "8000": { "label": "online-backend" },
    "80": { "label": "nginx (docker compose)" },
    "5432": { "label": "postgres" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "lokalise.i18n-ally",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  }
}
