{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "globalEnv": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "BOT_CREDENTIALS",
    "ADMIN_CREDENTIALS",
    "DATABASE_URL",
    "GAME_GLOBAL_START_T",
    "GAME_GLOBAL_END_T",
    "DEV_SERVER_HOST",
    "SITE_BASE",
    "VITE_SENTRY_DSN"
  ],
  "tasks": {
    "start": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["dist", "build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist", "build"],
      "cache": false,
      "env": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      // Build the workspace's dependencies before starting anything. Without
      // this a frontend's Vite dev server races the package watchers' first
      // build and resolves `game` through its exports map while the dist does
      // not exist yet. The watchers keep it fresh from there. The backend
      // bundles the packages from source and opts out in its own turbo.json.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
