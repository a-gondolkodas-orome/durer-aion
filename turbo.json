{
  "$schema": "https://turbo.build/schema.json",
  // Both forms: `.env.*` matches .env.docker and .env.local, and matches
  // neither a bare `.env` nor apps/*/.env — which seed-env-files.mjs writes and
  // which vite reads at build time for the VITE_* settings it inlines.
  "globalDependencies": ["**/.env", "**/.env.*"],
  "globalEnv": [
    "BOT_CREDENTIALS",
    "ADMIN_CREDENTIALS",
    "DATABASE_URL",
    "DEV_SERVER_HOST",
    "SITE_BASE",
    "VITE_SENTRY_DSN",
    // Set by the three frontends' vite configs from `git rev-parse HEAD` when
    // it is unset, which is every local build — so locally they share one hash
    // bucket, and a restored bundle names the commit that first built these
    // exact sources rather than the one checked out. The trees being identical
    // is what makes that only a difference of identity. The Pages workflow sets
    // it per run, where the banner has to be exact and no cache persists.
    "VITE_GIT_COMMIT_HASH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Globbed: a bare "dist" matches the directory entry, not the files in
      // it, so turbo would cache a hit it could restore nothing from. Every
      // workspace that builds emits here; nothing emits `build/`.
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // One ESLint process per workspace, not one over the whole repo. A single
    // `eslint .` holds a TypeScript program per tsconfig at once — each with its own
    // parsed copy of lib.*.d.ts, React and MUI — and needed 3072 MB of V8 heap where
    // every workspace on its own needs under 1024 MB. V8 sizes its default heap at
    // about half of physical memory, so that passed on a 16 GB runner and died at a
    // 2048 MB limit on a smaller one. .devcontainer/README.md has the measurements.
    //
    // No `dependsOn`: lint reads source, not dist. CI lints straight after `npm ci`,
    // where no package has been built yet.
    //
    // Not cached, deliberately. A workspace's type-aware lint reads *other*
    // workspaces' sources, which a per-package input hash does not cover, so a hit
    // could go stale across a package boundary. Caching it means `dependsOn: ["^lint"]`
    // to make the hashes transitive, plus the two eslint configs in
    // globalDependencies — a change worth making on its own, not a side effect.
    "lint": {
      "cache": false
    },
    "lint:fix": {
      "cache": false
    },
    // Files in no workspace: scripts/, the root configs, the eslint configs
    // themselves. Turbo runs a root script only when it is declared as `//#<task>`,
    // which is also what keeps the root `lint` script — the entry point that calls
    // `turbo run lint` — from recursing into itself.
    "//#lint:root": {
      "cache": false
    },
    "//#lint:fix:root": {
      "cache": false
    },
    "dev": {
      // Build the workspace's dependencies before starting anything. Without
      // this a frontend's Vite dev server races the package watchers' first
      // build and resolves `game` through its exports map while the dist does
      // not exist yet. The watchers keep it fresh from there. The backend
      // bundles the packages from source and opts out in its own turbo.json.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
