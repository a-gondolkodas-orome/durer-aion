{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*"],
  "globalEnv": [
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_MAPBOX_TOKEN",
    "BOT_CREDENTIALS",
    "ADMIN_CREDENTIALS",
    "DATABASE_URL",
    "GAME_GLOBAL_START_T",
    "GAME_GLOBAL_END_T",
    "DEV_SERVER_HOST",
    "SITE_BASE"
  ],
  "tasks": {
    "start": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["dist", "build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist", "build"],
      "cache": false,
      "env": []
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      // Build the workspace's dependencies before starting anything. Without
      // this the backend's `tsx watch` races the package watchers' first build
      // and imports `game` while its dist does not exist yet — which resolves
      // to the package's source barrel and dies on JSX the server never meant
      // to load. The watchers keep it fresh from there.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
